-- Get a readable full path
local function getFullPath(obj)
    local segments = {}
    local current = obj

    while current and current ~= game do
        table.insert(segments, 1, current.Name)
        current = current.Parent
    end

    return "game." .. table.concat(segments, ".")
end

-- Track rows for searching and refreshes
local remoteRows = {}
local scanGeneration = 0

-- Search logic
local function applySearch()
    local query = SearchBar.Text:lower()

    for _, entry in ipairs(remoteRows) do
        local matches =
            string.find(entry.name:lower(), query, 1, true)
            or string.find(entry.path:lower(), query, 1, true)

        entry.row.Visible = matches ~= nil
    end

    updateCanvas()
end

