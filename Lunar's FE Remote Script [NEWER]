        print("Path:", fullPath)
        print("Parent:", remote.Parent:GetFullName())

        if remote:IsA("RemoteEvent")
            or remote:IsA("RemoteFunction") then

            print("Remote reference is available to this client.")

            -- Only explicitly allowlisted test remotes may be called.
            if ALLOWED_TEST_REMOTES[fullPath] then
