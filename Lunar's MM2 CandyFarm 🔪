local function addLog(message)
    local entry = os.date("%H:%M:%S") .. " | " .. tostring(message)
    table.insert(logs, entry)

    while #logs > 80 do
        table.remove(logs, 1)
    end

    for _, child in ipairs(logScroll:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    for index, text in ipairs(logs) do
        local label = Instance.new("TextLabel")
        label.LayoutOrder = index
        label.Size = UDim2.new(1, -5, 0, 25)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = Color3.fromRGB(180, 225, 190)
        label.Font = Enum.Font.Code
        label.TextSize = 12
        label.TextWrapped = true
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = logScroll
    end

    print("[CoinMover] " .. entry)

    task.defer(function()
        if logScroll.Parent then
            logScroll.CanvasPosition = Vector2.new(
                0,
                math.max(0, logScroll.AbsoluteCanvasSize.Y)
            )
        end
    end)
end

--========================================================
-- NOCLIP
--========================================================

local function setPartNoclip(part)
    if not part:IsA("BasePart") then
        return
    end

    if originalCanCollide[part] == nil then
        originalCanCollide[part] = part.CanCollide
    end

    part.CanCollide = false
end

local function bindNoclipCharacter(character)
    if noclipCharacter == character then
        return
    end

    if noclipDescendantConnection then
        noclipDescendantConnection:Disconnect()
        noclipDescendantConnection = nil
    end

    noclipCharacter = character

    if not character or not noclipEnabled then
        return
    end

    for _, object in ipairs(character:GetDescendants()) do
        setPartNoclip(object)
    end

    noclipDescendantConnection = character.DescendantAdded:Connect(function(object)
        if noclipEnabled then
            setPartNoclip(object)
        end
    end)
end

local function enableNoclip()
    if noclipEnabled then
        return
    end

    noclipEnabled = true
    bindNoclipCharacter(player.Character)

    noclipStepConnection = RunService.Stepped:Connect(function()
        if not noclipEnabled then
            return
        end

        local character = player.Character

        if character ~= noclipCharacter then
            bindNoclipCharacter(character)
        end

        if character then
            for _, object in ipairs(character:GetDescendants()) do
                setPartNoclip(object)
            end
        end
    end)

    noclipButton.Text = "Noclip: ON"
    noclipButton.BackgroundColor3 = Color3.fromRGB(35, 155, 90)
    addLog("Noclip enabled.")
end

local function disableNoclip()
    if not noclipEnabled then
        return
    end

    noclipEnabled = false

    if noclipStepConnection then
        noclipStepConnection:Disconnect()
        noclipStepConnection = nil
    end

    if noclipDescendantConnection then
        noclipDescendantConnection:Disconnect()
        noclipDescendantConnection = nil
    end

    for part, originalValue in pairs(originalCanCollide) do
        if part and part.Parent then
            part.CanCollide = originalValue
        end
    end

    table.clear(originalCanCollide)
    noclipCharacter = nil

    noclipButton.Text = "Noclip: OFF"
    noclipButton.BackgroundColor3 = Color3.fromRGB(150, 55, 65)
    addLog("Noclip disabled; collision settings restored.")
end

--========================================================
-- FLIGHT
--========================================================

local function removeFlightRig()
    if flightVelocity then
        flightVelocity:Destroy()
        flightVelocity = nil
    end

    if flightGyro then
        flightGyro:Destroy()
        flightGyro = nil
    end

    if flightHumanoid and flightHumanoid.Parent then
        if originalAutoRotate ~= nil then
            flightHumanoid.AutoRotate = originalAutoRotate
        end

        if flightHumanoid.Health > 0 then
            flightHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end

    flightHumanoid = nil
    flightCharacter = nil
    originalAutoRotate = nil
end

local function prepareFlightCharacter(character)
    if not flyEnabled or not character then
        return
    end

    -- Avoid restarting the same asynchronous setup every frame.
    if pendingFlightCharacter == character or flightCharacter == character then
        return
    end

    pendingFlightCharacter = character
    flightSetupId += 1
    local setupId = flightSetupId

    task.spawn(function()
        local root = character:WaitForChild("HumanoidRootPart", 10)
        local humanoid = character:WaitForChild("Humanoid", 10)

        if setupId ~= flightSetupId
            or not flyEnabled
            or player.Character ~= character
            or not root
            or not humanoid
            or humanoid.Health <= 0 then

            if pendingFlightCharacter == character then
                pendingFlightCharacter = nil
            end
            return
        end

        removeFlightRig()

        -- Revalidate after cleanup.
        if not flyEnabled or player.Character ~= character then
            pendingFlightCharacter = nil
            return
        end

        flightCharacter = character
        flightHumanoid = humanoid
        originalAutoRotate = humanoid.AutoRotate
        humanoid.AutoRotate = false

        local velocity = Instance.new("BodyVelocity")
        velocity.Name = "CoinMoverFlightVelocity"
        velocity.MaxForce = Vector3.new(1e7, 1e7, 1e7)
        velocity.P = 1e4
        velocity.Velocity = Vector3.zero
        velocity.Parent = root
        flightVelocity = velocity

        local gyro = Instance.new("BodyGyro")
        gyro.Name = "CoinMoverFlightGyro"
        gyro.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
        gyro.P = 1e5
        gyro.D = 1000
        gyro.CFrame = root.CFrame
        gyro.Parent = root
        flightGyro = gyro

        pendingFlightCharacter = nil
        addLog("Flight ready for current character.")
    end)
end

local function enableFlight()
    if flyEnabled then
        return
    end

    flyEnabled = true
    prepareFlightCharacter(player.Character)

    flightUpdateConnection = RunService.Heartbeat:Connect(function()
        if not flyEnabled then
            return
        end

        local character = player.Character
        if not character then
            return
        end

        if flightCharacter ~= character then
            prepareFlightCharacter(character)
            return
        end

        local humanoid = flightHumanoid
        local velocity = flightVelocity
        local gyro = flightGyro
        local root = character:FindFirstChild("HumanoidRootPart")

        if not humanoid or not velocity or not gyro or not root
            or humanoid.Health <= 0 then
            return
        end

        -- Allow automatic CFrame movement while flight remains ON.
        -- Hold physics steady instead of competing for position.
        if running then
            velocity.Velocity = Vector3.zero
            gyro.CFrame = root.CFrame
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local look = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector

        local forward = Vector3.new(look.X, 0, look.Z)
        local rightFlat = Vector3.new(right.X, 0, right.Z)

        if forward.Magnitude > 0 then
            forward = forward.Unit
        end

        if rightFlat.Magnitude > 0 then
            rightFlat = rightFlat.Unit
        end

        local forwardInput = 0
        local sideInput = 0
        local verticalInput = 0

        if UserInputService:IsKeyDown(Enum.KeyCode.W)
            or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
            forwardInput += 1
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.S)
            or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
            forwardInput -= 1
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.D)
            or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
            sideInput += 1
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.A)
            or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
            sideInput -= 1
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.Space)
            or UserInputService:IsKeyDown(Enum.KeyCode.E) then
            verticalInput += 1
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
            or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
            verticalInput -= 1
        end

        local horizontal = forward * forwardInput
            + rightFlat * sideInput

        -- Touch users can use the normal Roblox movement thumbstick.
        if UserInputService.TouchEnabled
            and forwardInput == 0
            and sideInput == 0 then

            local moveDirection = humanoid.MoveDirection
            horizontal = Vector3.new(
                moveDirection.X,
                0,
                moveDirection.Z
            )
        end

        if horizontal.Magnitude > 1 then
            horizontal = horizontal.Unit
        end

        velocity.Velocity =
            horizontal * FLY_SPEED
            + Vector3.new(0, verticalInput * FLY_SPEED, 0)

        if forward.Magnitude > 0 then
            gyro.CFrame = CFrame.lookAt(
                root.Position,
                root.Position + forward
            )
        end
    end)

    flyButton.Text = "Fly: ON"
    flyButton.BackgroundColor3 = Color3.fromRGB(35, 155, 90)
    addLog("Flight enabled.")
end

local function disableFlight()
    if not flyEnabled then
        return
    end

    flyEnabled = false
    flightSetupId += 1
    pendingFlightCharacter = nil

    if flightUpdateConnection then
        flightUpdateConnection:Disconnect()
        flightUpdateConnection = nil
    end

    removeFlightRig()

    flyButton.Text = "Fly: OFF"
    flyButton.BackgroundColor3 = Color3.fromRGB(150, 55, 65)
    addLog("Flight disabled.")
end

local function toggleFlight()
    if flyEnabled then
        disableFlight()
    else
        enableFlight()
    end
end

--========================================================
-- COIN TARGET SEARCH
--========================================================

local function isValidTarget(object)
    return object:IsA("BasePart")
        and object.Name == TARGET_NAME
        and object:IsDescendantOf(workspace)
end

local function getAllTargets()
    local targets = {}

    for _, object in ipairs(workspace:GetDescendants()) do
        if isValidTarget(object) then
            table.insert(targets, object)
        end
    end

    return targets
end

local function findNextTarget(root)
    local targets = getAllTargets()
    local available = {}

    for _, target in ipairs(targets) do
        if not visitedTargets[target] then
            table.insert(available, target)
        end
    end

    if #available == 0 then
        visitedTargets = {}

        for _, target in ipairs(targets) do
            table.insert(available, target)
        end
    end

    if #available > 1 and currentTarget then
        local filtered = {}

        for _, target in ipairs(available) do
            if target ~= currentTarget then
                table.insert(filtered, target)
            end
        end

        if #filtered > 0 then
            available = filtered
        end
    end

    table.sort(available, function(a, b)
        return (a.Position - root.Position).Magnitude
            < (b.Position - root.Position).Magnitude
    end)

    return available[1]
end

--========================================================
-- STOP MOVEMENT
--========================================================

local function stopMovement(message)
    running = false
    sessionId += 1

    currentTarget = nil
    waitingUntil = 0
    searchTimer = 0

    if movementConnection then
        movementConnection:Disconnect()
        movementConnection = nil
    end

    statusLabel.Text = "Status: Stopped"
    statusLabel.TextColor3 = Color3.fromRGB(255, 190, 100)
    targetLabel.Text = "Current target: None"

    if message then
        addLog(message)
    end
end

--========================================================
-- CONTINUOUS CFRAME MOVEMENT
--========================================================

local function startMovement()
    if running then
        addLog("Movement is already running.")
        return
    end

    local requestedSpeed = tonumber(speedBox.Text)

    if not requestedSpeed then
        addLog("ERROR: Enter a valid numeric speed.")
        return
    end

    speed = math.clamp(requestedSpeed, MIN_SPEED, MAX_SPEED)
    speedBox.Text = tostring(speed)

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not character or not humanoid or humanoid.Health <= 0 or not root then
        addLog("Character is not ready yet.")
        return
    end

    running = true
    sessionId += 1
    local thisSession = sessionId

    currentTarget = nil
    visitedTargets = {}
    searchTimer = 1
    waitingUntil = 0
    noTargetsLogged = false

    statusLabel.Text = "Status: Running"
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)

    addLog("CFrame movement started.")
    addLog("Speed: " .. speed .. " studs/second.")
    addLog("Stay time per coin: " .. STAY_AT_PART .. " seconds.")

    movementConnection = RunService.Heartbeat:Connect(function(dt)
        if not running or sessionId ~= thisSession then
            return
        end

        character = player.Character
        humanoid = character and character:FindFirstChildOfClass("Humanoid")
        root = character and character:FindFirstChild("HumanoidRootPart")

        -- Keep running enabled through death/respawn.
        if not character or not humanoid or not root
            or humanoid.Health <= 0 then

            statusLabel.Text = "Status: Waiting for respawn"
            targetLabel.Text = "CFrame will resume after respawn."
            return
        end

        if currentTarget and not isValidTarget(currentTarget) then
            addLog("Target removed; selecting another.")
            currentTarget = nil
            waitingUntil = 0
            searchTimer = 1
        end

        -- Pause between coins, not between respawns.
        if not currentTarget and os.clock() < waitingUntil then
            statusLabel.Text = string.format(
                "Status: Waiting (%.1fs)",
                math.max(0, waitingUntil - os.clock())
            )
            targetLabel.Text = "Waiting at previous coin..."
            return
        end

        searchTimer += dt

        if not currentTarget and searchTimer >= 0.1 then
            searchTimer = 0
            currentTarget = findNextTarget(root)

            if currentTarget then
                noTargetsLogged = false
                targetLabel.Text =
                    "Current target: " .. currentTarget:GetFullName()
                statusLabel.Text = flyEnabled
                    and "Status: Moving (Fly ON)"
                    or "Status: Moving"
            elseif not noTargetsLogged then
                noTargetsLogged = true
                statusLabel.Text = "Status: Waiting for parts"
                addLog("No BaseParts named Coin_Server found in Workspace.")
            end
        end

        if not currentTarget then
            return
        end

        local destination = currentTarget.Position
            + Vector3.new(
                0,
                currentTarget.Size.Y / 2 + TARGET_HEIGHT,
                0
            )

        local offset = destination - root.Position
        local distance = offset.Magnitude

        if distance <= ARRIVAL_DISTANCE then
            local reachedName = currentTarget:GetFullName()

            visitedTargets[currentTarget] = true
            currentTarget = nil
            waitingUntil = os.clock() + STAY_AT_PART
            searchTimer = 0

            targetLabel.Text = "Waiting at coin..."
            statusLabel.Text = string.format(
                "Status: Waiting (%.2fs)",
                STAY_AT_PART
            )

            addLog("Reached: " .. reachedName)
            addLog("Waiting " .. STAY_AT_PART .. " seconds.")
            return
        end

        local step = math.min(speed * dt, distance)
        local nextPosition = root.Position + offset.Unit * step
        local rotation = root.CFrame.Rotation

        character:PivotTo(CFrame.new(nextPosition) * rotation)
    end)
end

