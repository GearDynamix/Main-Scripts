SearchBox.PlaceholderText = "Search For Created Words..." -- Shows when empty
SearchBox.TextScaled = false
SearchBox.TextSize = 16
SearchBox.Font = Enum.Font.GothamBold
SearchBox.TextColor3 = Color3.new(60, 60, 60)

-- Behavior Settings
SearchBox.ClearTextOnFocus = true -- Clears previous text when clicked
SearchBox.TextXAlignment = Enum.TextXAlignment.Left -- Typical for inputs

SearchBox.Parent = MainFrame

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local searchText = SearchBox.Text:lower() -- Convert to lowercase for easier matching
    
    -- Loop through everything inside the ScrollFrame
    for _, item in ipairs(ScrollFrame:GetChildren()) do
        -- Only check objects that are TextButtons (to avoid the UIListLayout)
        if item:IsA("TextButton") then
            local buttonText = item.Text:lower()
            
            -- Check if search is empty OR if the button text contains the search word
            if searchText == "" or string.find(buttonText, searchText) then
                item.Visible = true
            else
                item.Visible = false
            end
        end
    end
end)

Instance.new("UICorner", SearchBox).CornerRadius = UDim.new(0, 8)


